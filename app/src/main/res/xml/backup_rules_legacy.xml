<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy backup rules (android:fullBackupContent) for API levels below 31,
  where android:dataExtractionRules is not understood. Same intent as
  res/xml/backup_rules.xml: no persisted game state leaves the device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
